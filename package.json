{
  "name": "asteroid-blaster",
  "version": "0.1.0",
  "description": "PixiJS arcade shooter — portfolio demo component",
  "type": "module",
  "main": "./dist/asteroid-blaster.umd.cjs",
  "module": "./dist/asteroid-blaster.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/asteroid-blaster.es.js",
      "require": "./dist/asteroid-blaster.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "pixi.js": "^8.0.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/stats.js": "^0.17.4",
    "@vitejs/plugin-react": "^4.0.0",
    "stats.js": "^0.17.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.0.0"
  }
}
